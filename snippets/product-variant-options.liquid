{%- assign current_variant = product.selected_or_first_available_variant -%}

<form action="/cart/add" method="post" id="add-to-cart-form">
  <input type="hidden" name="id" value="{{ current_variant.id }}">

  <div class="variant-boxes">
    {%- for variant in product.variants -%}
      <div class="variant-box  {% if forloop.index0 == 0 %}selected{% endif %}" onclick="selectVariant('{{ variant.id }}')" id="variant-box-{{ variant.id }}">
        <!-- Variant Title -->
        <h3 class="variant-title">{{ variant.title }}</h3>

        <div class="variant-pricing">
          {%- if variant.compare_at_price > variant.price -%}
            <span class="original-price">{{ variant.compare_at_price | money }}</span>
            <span class="sale-price">{{ variant.price | money }}</span>
          {%- else -%}
            <span class="regular-price">{{ variant.price | money }}</span>
          {%- endif -%}
        </div>
        {% if forloop.index0 == 0 %}
        <span class="popular-badge">MOST POPULAR KIT</span>
        {% endif %}
        {%- if variant.metafields['custom']['description'] != blank -%}
          <div class="variant-description">
            {{ variant.metafields['custom']['description'] | metafield_tag }}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
  
  <button type="submit" class="add-to-cart-button">
    Add to Cart
  </button>
</form>

<!-- JavaScript to handle variant selection -->
<script>
  function selectVariant(variantId) {
    // Update the hidden input in the form with the selected variant's ID
    document.querySelector('form#add-to-cart-form input[name="id"]').value = variantId;

    // Update the selected variant box UI (optional)
    var allVariantBoxes = document.querySelectorAll('.variant-box');
    allVariantBoxes.forEach(function(box) {
      box.classList.remove('selected'); // Remove selected class from all boxes
    });

    // Highlight the selected variant box
    document.getElementById('variant-box-' + variantId).classList.add('selected');
  }
</script>

<!-- Add some basic CSS for the layout -->
<style>
.shopify-section.section .gradient.color-scheme-1 {
    background: #f6f6f6;
}
  .variant-boxes {
      display: grid;
      grid-template-columns: 100%;
      text-align: left;
  }

  .variant-box {
      padding: 20px;
      cursor: pointer;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      border: 2px solid #C4C4C4;
      border-radius: 10px;
      background-clip: padding-box;
      position: relative;
      background: linear-gradient(#ffffff, #ffffff);
  }

  .variant-box.selected {
      border: 2px solid #c4c4c400;
  }
  .variant-box:after {
      position: absolute;
      top: -3px;
      bottom: -3.9px;
      left: -3px;
      right: -3px;
      background: linear-gradient(#2D5ECE, #9F4EA1);
      content: '';
      z-index: -1;
      border-radius: 10px;
      opacity: 0;
      transition: 0.5s;
  }

  .variant-box.selected:after {
      opacity: 1;
      transition: 0.5s;
  }

  .variant-pricing .original-price {
      position: relative;
  }

  .variant-pricing .sale-price {
      margin-left: 10px;
  }
  form#add-to-cart-form {
      text-align: center;
  }
  .add-to-cart-button {
      margin-top: 20px;
      background-color: #07C961;
      color: white;
      border: none;
      cursor: pointer;
      display: inline-block;
      height: 79px;
      width: 100%;
      max-width: 548px;
      border-radius: 48.5px;
      font-size: 24px;
      line-height: 36px;
  }

  .add-to-cart-button:hover {
    background-color: #005bb5;
  }
  .product__title h1 {
    font-size: 36px;
    line-height: 54px;
    font-weight: 700;
}
.yotpo-bottom-line-scroll-panel .star-container:not(:last-child) {
    margin-right: 12.2px !important;
}

.yotpo-bottom-line-scroll-panel .star-container svg {
    width: 18.12px;
    height: 16px;
}

body .product__info-container {
    max-width: 63.4rem;
}

.product__info-container .product__title {
    margin-bottom: 0;
}
.yotpo-sr-bottom-line-right-panel .yotpo-sr-bottom-line-text.yotpo-sr-bottom-line-text--right-panel {
    font-size: 18px !important;
    line-height: 27px !important;
    font-weight: 300 !important;
}

html body  p.product__text.inline-richtext {
